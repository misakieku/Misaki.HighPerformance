    public static {typeName} operator -(in {typeName} left, in {typeName} right)
    {{
        return new {typeName}
        {{
{ForEachDimension(dimension, 12, Environment.NewLine, (dim, sb) => sb.Append($"{components[dim]} = left.{components[dim]} - right.{components[dim]},"))}
        }};
    }}

